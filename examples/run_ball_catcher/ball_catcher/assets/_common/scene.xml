<!-- Shared scene dressing: skybox, ground plane and a light.
     Reused across environments. Attached into the WORLD frame by each env, so it
     must not contain anything robot- or task-specific. -->
<mujoco model="scene">

  <option integrator="implicitfast" timestep="0.0025" cone="elliptic"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <!-- no skybox - all assets get copied across MjSpecs - removing it raises max envs by 20x -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.2 0.2 0.4" width="4" height="4"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
