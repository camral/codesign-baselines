<!-- Shared scene dressing for grippers with heightfields - 
they can't collide with planes, so the floor is a box. -->
<mujoco model="scene">

  <option integrator="implicitfast" timestep="0.005" cone="pyramidal"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <!-- if you run short on memory, consider deleting the skybox texture and setting the ground w/h to 1/1 -->
    <texture type="skybox" name="skybox" builtin="checker" mark="edge" rgb1="0.3 0.45 0.6" rgb2="0.15 0.3 0.45"
      markrgb="0.3 0.3 0.6" width="4" height="4"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.2 0.2 0.4" width="4" height="4"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" directional="true"/>
    <geom name="floor" type="box" pos="0 0 -0.05" size="1 1 0.05"  material="groundplane"/>
  </worldbody>
</mujoco>
